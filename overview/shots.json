{
  "url": "https://jkw2lo.github.io/ui_field_guide/",
  "shots": [
    {
      "file": "desktop.png",
      "settle": 1500
    },
    {
      "file": "controls.png",
      "scale": 2,
      "settle": 1500,
      "steps": [
        "eval:document.querySelector('#sec-controls').scrollIntoView({ block: 'start' })",
        "wait:1500"
      ],
      "clip": "#sec-controls",
      "pad": 0,
      "maxHeight": 600,
      "size": [
        1440,
        1400
      ]
    },
    {
      "file": "detail.png",
      "scale": 2,
      "settle": 1500,
      "steps": [
        "eval:{ const c = [...document.querySelectorAll('.card')].find(c => /ctl\\.thermostat/.test(c.textContent)) || document.querySelector('#sec-controls .card'); c.click(); }",
        "wait:1000"
      ],
      "clip": ".drawer",
      "pad": 0,
      "maxHeight": 900
    },
    {
      "file": "builder.png",
      "settle": 1500,
      "steps": [
        "eval:{ const b = [...document.querySelectorAll('button, a')].find(b => b.offsetParent && b.textContent.trim().replace(/\\s+/g,' ').startsWith(\"Mockup builder\")); if (b) b.click(); }",
        "wait:1500"
      ]
    }
  ]
}
